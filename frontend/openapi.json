{
 "openapi": "3.1.0",
 "info": {
  "title": "HospitalShield AI API",
  "description": "Climate-resilient hospital digital twin (HC-03 planning prototype, synthetic data).",
  "version": "1.0.0"
 },
 "paths": {
  "/health": {
   "get": {
    "summary": "Health",
    "description": "Liveness plus optional services, reported as optional (never failure).",
    "operationId": "health_health_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "title": "Response Health Health Get"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/hospital/baseline": {
   "get": {
    "summary": "Hospital Baseline",
    "description": "The SYNTHETIC baseline hospital configuration.",
    "operationId": "hospital_baseline_api_v1_hospital_baseline_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "title": "Response Hospital Baseline Api V1 Hospital Baseline Get"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/model-card": {
   "get": {
    "summary": "Model Card",
    "description": "Model card: purpose, scope, honest limitations (B1).",
    "operationId": "model_card_api_v1_model_card_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "title": "Response Model Card Api V1 Model Card Get"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/scenarios": {
   "get": {
    "summary": "Scenarios",
    "description": "Presets and validated ranges for the Scenario Lab UI (B9).",
    "operationId": "scenarios_api_v1_scenarios_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ScenarioInfo"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/weather": {
   "get": {
    "summary": "Weather",
    "description": "Weather source status. The default demo weather is SYNTHETIC_PROFILE;\nlive Open-Meteo is optional and labelled REAL WEATHER when used.",
    "operationId": "weather_api_v1_weather_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "title": "Response Weather Api V1 Weather Get"
        }
       }
      }
     }
    }
   }
  },
